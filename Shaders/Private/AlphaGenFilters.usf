    float val = saturate((color.r - 0.5) * FilterParams.x + 0.5);
    FilterOutputTexture[pixel] = float4(val, val, val, color.a);
}

[numthreads(8, 8, 1)]
void SpherizeCS(uint3 ThreadId : SV_DispatchThreadID)
{
    uint2 pixel = ThreadId.xy;
    if (pixel.x >= FilterTextureSize.x || pixel.y >= FilterTextureSize.y)
        return;
    
    float2 uv = (float2(pixel) + 0.5) / float2(FilterTextureSize);
    float amount = FilterParams.x;
    
    float2 centered = uv - 0.5;
    float dist = length(centered);
    float2 dir = normalize(centered + 0.0001);
    float new_dist = dist * (1.0 - amount * (1.0 - dist * 2.0));
    float2 sphere_uv = dir * new_dist + 0.5;
    
    // Clamp to valid range - no more black edges causing gray artifacting
    // The sampler uses AM_Clamp anyway, but explicit clamp + original sample fallback
    // is more robust for extreme distortion values
    sphere_uv = clamp(sphere_uv, 0.0, 1.0);
    FilterOutputTexture[pixel] = FilterInputTexture.SampleLevel(FilterInputSampler, sphere_uv, 0.0);
}

[numthreads(8, 8, 1)]
void SpiralCS(uint3 ThreadId : SV_DispatchThreadID)
{
    uint2 pixel = ThreadId.xy;
    if (pixel.x >= FilterTextureSize.x || pixel.y >= FilterTextureSize.y)
        return;
    
    float2 uv = (float2(pixel) + 0.5) / float2(FilterTextureSize);
    float2 centered = uv - 0.5;
    float dist = length(centered);
    float angle = atan2(centered.y, centered.x);
    float twist = FilterParams.x * (1.0 - dist * 2.0);
    angle += twist;
    float2 spiral_uv = float2(cos(angle), sin(angle)) * dist + 0.5;
    
    // Clamp to valid range - keeps edges clean at extreme twist values
    spiral_uv = clamp(spiral_uv, 0.0, 1.0);
    FilterOutputTexture[pixel] = FilterInputTexture.SampleLevel(FilterInputSampler, spiral_uv, 0.0);
}

[numthreads(8, 8, 1)]
void DomainWarpCS(uint3 ThreadId : SV_DispatchThreadID)
{
    uint2 pixel = ThreadId.xy;
    if (pixel.x >= FilterTextureSize.x || pixel.y >= FilterTextureSize.y)
        return;
    
    float2 uv = (float2(pixel) + 0.5) / float2(FilterTextureSize);
    float strength = FilterParams.x;
    float scale = max(1.0, FilterParams.y);
    
    float2 noise_coord = uv * scale;
    float noise_x = sin(noise_coord.x * 12.9898 + noise_coord.y * 78.233) * 43758.5453;
    float noise_y = sin((noise_coord.x * 78.233 + noise_coord.y * 12.9898) + 100.0) * 43758.5453;
    
    float disp_x = (frac(noise_x) * 2.0 - 1.0) * strength * 0.2;
    float disp_y = (frac(noise_y) * 2.0 - 1.0) * strength * 0.2;
    float2 warped_uv = saturate(uv + float2(disp_x, disp_y));
    
    FilterOutputTexture[pixel] = FilterInputTexture.SampleLevel(FilterInputSampler, warped_uv, 0.0);
}
