// Simple copy shader - samples input and writes to output unchanged
// More reliable than RDG AddCopyTexturePass for external->internal texture copy
[numthreads(8, 8, 1)]
void CopyCS(uint3 ThreadId : SV_DispatchThreadID)
{
    uint2 pixel = ThreadId.xy;
    if (pixel.x >= FilterTextureSize.x || pixel.y >= FilterTextureSize.y)
        return;
    
    float2 uv = (float2(pixel) + 0.5) / float2(FilterTextureSize);
    FilterOutputTexture[pixel] = FilterInputTexture.SampleLevel(FilterInputSampler, uv, 0.0);
}


[numthreads(8, 8, 1)]
void BlurCS(uint3 ThreadId : SV_DispatchThreadID)
{
    uint2 pixel = ThreadId.xy;
    if (pixel.x >= FilterTextureSize.x || pixel.y >= FilterTextureSize.y)
        return;
    
    float2 texel_size = 1.0 / float2(FilterTextureSize);
    float2 uv = (float2(pixel) + 0.5) * texel_size;
    int radius = int(clamp(FilterParams.x, 0.0, 16.0));
    
    if (radius == 0)
    {
        FilterOutputTexture[pixel] = FilterInputTexture.SampleLevel(FilterInputSampler, uv, 0.0);
        return;
    }
    
    float4 sum = float4(0, 0, 0, 0);
    float total_weight = 0.0;
    
    for (int y = -radius; y <= radius; y++)
    {
        for (int x = -radius; x <= radius; x++)
        {
            float2 offset = float2(x, y) * texel_size;
            float weight = 1.0 / (1.0 + length(float2(x, y)));
            float4 sample_color = FilterInputTexture.SampleLevel(FilterInputSampler, uv + offset, 0.0);
            sum += sample_color * weight;
            total_weight += weight;
        }
    }
    
    FilterOutputTexture[pixel] = sum / total_weight;
}

[numthreads(8, 8, 1)]
void SharpenCS(uint3 ThreadId : SV_DispatchThreadID)
{
    uint2 pixel = ThreadId.xy;
    if (pixel.x >= FilterTextureSize.x || pixel.y >= FilterTextureSize.y)
        return;
    
    float2 texel_size = 1.0 / float2(FilterTextureSize);
    float2 uv = (float2(pixel) + 0.5) * texel_size;
    float amount = FilterParams.x;
    
    float4 center = FilterInputTexture.SampleLevel(FilterInputSampler, uv, 0.0);
    float4 blur = FilterInputTexture.SampleLevel(FilterInputSampler, uv + float2(-texel_size.x, 0), 0.0);
    blur += FilterInputTexture.SampleLevel(FilterInputSampler, uv + float2(texel_size.x, 0), 0.0);
    blur += FilterInputTexture.SampleLevel(FilterInputSampler, uv + float2(0, -texel_size.y), 0.0);
    blur += FilterInputTexture.SampleLevel(FilterInputSampler, uv + float2(0, texel_size.y), 0.0);
    blur *= 0.25;
    
    float4 detail = center - blur;
    FilterOutputTexture[pixel] = saturate(center + detail * amount);
}

[numthreads(8, 8, 1)]
