[numthreads(8, 8, 1)]
void DilateCS(uint3 ThreadId : SV_DispatchThreadID)
{
    uint2 pixel = ThreadId.xy;
    if (pixel.x >= FilterTextureSize.x || pixel.y >= FilterTextureSize.y)
        return;
    
    float2 texel_size = 1.0 / float2(FilterTextureSize);
    float2 uv = (float2(pixel) + 0.5) * texel_size;
    int radius = int(clamp(FilterParams.x, 1.0, 16.0));
    
