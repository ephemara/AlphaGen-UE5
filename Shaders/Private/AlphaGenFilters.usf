[numthreads(8, 8, 1)]
void PosterizeCS(uint3 ThreadId : SV_DispatchThreadID)
{
    uint2 pixel = ThreadId.xy;
    if (pixel.x >= FilterTextureSize.x || pixel.y >= FilterTextureSize.y)
        return;
    
    float2 uv = (float2(pixel) + 0.5) / float2(FilterTextureSize);
    float4 color = FilterInputTexture.SampleLevel(FilterInputSampler, uv, 0.0);
    float steps = max(2.0, FilterParams.x);
    float val = floor(color.r * steps) / (steps - 1.0);
    FilterOutputTexture[pixel] = float4(val, val, val, color.a);
}

[numthreads(8, 8, 1)]
void PixelateCS(uint3 ThreadId : SV_DispatchThreadID)
{
    uint2 pixel = ThreadId.xy;
    if (pixel.x >= FilterTextureSize.x || pixel.y >= FilterTextureSize.y)
        return;
    
    float2 tex_size = float2(FilterTextureSize);
    float2 uv = (float2(pixel) + 0.5) / tex_size;
    float size = max(1.0, FilterParams.x);
    
    float2 block_uv = floor(uv * tex_size / size) * size / tex_size;
    float2 centered = block_uv + (size * 0.5) / tex_size;
    float4 color = FilterInputTexture.SampleLevel(FilterInputSampler, centered, 0.0);
    FilterOutputTexture[pixel] = color;
}

[numthreads(8, 8, 1)]
void EdgeDetectCS(uint3 ThreadId : SV_DispatchThreadID)
{
    uint2 pixel = ThreadId.xy;
    if (pixel.x >= FilterTextureSize.x || pixel.y >= FilterTextureSize.y)
        return;
    
    float2 texel_size = 1.0 / float2(FilterTextureSize);
    float2 uv = (float2(pixel) + 0.5) * texel_size;
    
    // Sobel kernel samples
    float tl = FilterInputTexture.SampleLevel(FilterInputSampler, uv + float2(-texel_size.x, -texel_size.y), 0.0).r;
    float t  = FilterInputTexture.SampleLevel(FilterInputSampler, uv + float2(0, -texel_size.y), 0.0).r;
    float tr = FilterInputTexture.SampleLevel(FilterInputSampler, uv + float2(texel_size.x, -texel_size.y), 0.0).r;
    float l  = FilterInputTexture.SampleLevel(FilterInputSampler, uv + float2(-texel_size.x, 0), 0.0).r;
    float r  = FilterInputTexture.SampleLevel(FilterInputSampler, uv + float2(texel_size.x, 0), 0.0).r;
    float bl = FilterInputTexture.SampleLevel(FilterInputSampler, uv + float2(-texel_size.x, texel_size.y), 0.0).r;
    float b  = FilterInputTexture.SampleLevel(FilterInputSampler, uv + float2(0, texel_size.y), 0.0).r;
    float br = FilterInputTexture.SampleLevel(FilterInputSampler, uv + float2(texel_size.x, texel_size.y), 0.0).r;
    
    float gx = -tl - 2.0 * l - bl + tr + 2.0 * r + br;
    float gy = -tl - 2.0 * t - tr + bl + 2.0 * b + br;
    float edge = saturate(sqrt(gx * gx + gy * gy) * FilterParams.x);
    
    FilterOutputTexture[pixel] = float4(edge, edge, edge, 1.0);
}

[numthreads(8, 8, 1)]
void LevelsCS(uint3 ThreadId : SV_DispatchThreadID)
{
    uint2 pixel = ThreadId.xy;
    if (pixel.x >= FilterTextureSize.x || pixel.y >= FilterTextureSize.y)
        return;
    
    float2 uv = (float2(pixel) + 0.5) / float2(FilterTextureSize);
    float4 color = FilterInputTexture.SampleLevel(FilterInputSampler, uv, 0.0);
    
    float bp = FilterParams.x;
    float wp = max(bp + 0.01, FilterParams.y);
    float g = max(0.1, FilterParams.z);
    
    float val = (color.r - bp) / (wp - bp);
    val = saturate(val);
    val = pow(val, g);
    
    FilterOutputTexture[pixel] = float4(val, val, val, color.a);
}

[numthreads(8, 8, 1)]
void ContrastCS(uint3 ThreadId : SV_DispatchThreadID)
{
    uint2 pixel = ThreadId.xy;
    if (pixel.x >= FilterTextureSize.x || pixel.y >= FilterTextureSize.y)
        return;
    
    float2 uv = (float2(pixel) + 0.5) / float2(FilterTextureSize);
