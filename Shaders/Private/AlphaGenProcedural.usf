// ============================================================================
// HEXAGON GRID (from guide.txt)
// ============================================================================

// Params: x=Scale, y=EdgeThickness, z=Seed
[numthreads(8, 8, 1)]
void GenerateHexagonCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (DispatchThreadId.x >= TextureSize.x || DispatchThreadId.y >= TextureSize.y)
        return;
    
    float2 uv = (float2(DispatchThreadId.xy) + 0.5) / float2(TextureSize);
    
    float scale = ProceduralParams.x;
    float thickness = max(ProceduralParams.y, 0.001);
    
    float2 hex = hexagon_grid(uv, scale);
    // hex.x is distance to edge (1 in center, 0 at edge)
    float value = smoothstep(0.0, thickness, hex.x);
    
    OutputTexture[DispatchThreadId.xy] = float4(value, value, value, 1.0);
}


