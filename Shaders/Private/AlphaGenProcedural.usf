// Seamless 4D Tiling Noise kernel - uses Clifford Torus mapping for perfect seams
// noise_type in ProceduralParams2.w: 0=standard, 1=ridged, 2=billowy
[numthreads(8, 8, 1)]
void GenerateSeamlessNoiseCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (DispatchThreadId.x >= TextureSize.x || DispatchThreadId.y >= TextureSize.y)
        return;
    
    float2 uv = (float2(DispatchThreadId.xy) + 0.5) / float2(TextureSize);
    
    float scale = ProceduralParams.x;
    int octaves = (int)ProceduralParams.y;
    float seed = ProceduralParams.z;
    int noise_type = (int)ProceduralParams2.w;
    
    float value;
    
    if (noise_type == 1)
        value = seamless_noise_4d_ridged(uv, scale, octaves, seed);
    else if (noise_type == 2)
        value = seamless_noise_4d_billowy(uv, scale, octaves, seed);
    else
        value = seamless_noise_4d(uv, scale, octaves, seed);
    
    // Slight contrast boost since 4D value noise can be softer
    value = smoothstep(0.15, 0.85, value);
    
    OutputTexture[DispatchThreadId.xy] = float4(value, value, value, 1.0);
}


// ============================================================================
// CROSSHATCH PATTERN
// ============================================================================

// Params: x=Scale, y=Thickness, z=Angle
[numthreads(8, 8, 1)]
void GenerateCrosshatchCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (DispatchThreadId.x >= TextureSize.x || DispatchThreadId.y >= TextureSize.y)
        return;
    
    float2 uv = (float2(DispatchThreadId.xy) + 0.5) / float2(TextureSize);
    
    float scale = ProceduralParams.x;
    float thickness = ProceduralParams.y;
    float angle = ProceduralParams.z;
    
    float value = crosshatch(uv, scale, thickness, angle);
    
    OutputTexture[DispatchThreadId.xy] = float4(value, value, value, 1.0);
}

// ============================================================================
// WAVE PATTERNS
// ============================================================================

// Params: x=Frequency, y=Amplitude, z=Type (0=horizontal, 1=vertical, 2=radial)
[numthreads(8, 8, 1)]
void GenerateWavesCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (DispatchThreadId.x >= TextureSize.x || DispatchThreadId.y >= TextureSize.y)
        return;
    
    float2 uv = (float2(DispatchThreadId.xy) + 0.5) / float2(TextureSize);
    
    float frequency = ProceduralParams.x;
    float amplitude = ProceduralParams.y;
    float type = ProceduralParams.z;
    
    float value;
    if (type < 0.5)
        value = wave_horizontal(uv, frequency, amplitude);
    else if (type < 1.5)
        value = wave_vertical(uv, frequency, amplitude);
    else
        value = wave_radial(uv, frequency, amplitude);
    
    OutputTexture[DispatchThreadId.xy] = float4(value, value, value, 1.0);
}

