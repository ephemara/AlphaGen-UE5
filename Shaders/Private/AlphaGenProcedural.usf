// Perlin/Noise kernel - supports multiple noise types via ProceduralParams2.w
// noise_type: 0=perlin, 1=simplex, 2=ridged, 3=billowy, 4=worley
[numthreads(8, 8, 1)]
void GeneratePerlinCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (DispatchThreadId.x >= TextureSize.x || DispatchThreadId.y >= TextureSize.y)
        return;
    
    float2 uv = (float2(DispatchThreadId.xy) + 0.5) / float2(TextureSize);
    
    float scale = ProceduralParams.x;
    int octaves = (int)ProceduralParams.y;
    float seed = ProceduralParams.z;
    int noise_type = (int)ProceduralParams2.w;
    
    float value;
    
    if (noise_type == 1)
        value = simplex_noise(uv, scale, octaves, seed);
    else if (noise_type == 2)
        value = ridged_noise(uv, scale, octaves, seed);
    else if (noise_type == 3)
        value = billowy_noise(uv, scale, octaves, seed);
    else if (noise_type == 4)
        value = worley_noise(uv, scale, 1.0, seed);
    else
        value = perlin_noise(uv, scale, octaves, seed);
    
    OutputTexture[DispatchThreadId.xy] = float4(value, value, value, 1.0);
}

