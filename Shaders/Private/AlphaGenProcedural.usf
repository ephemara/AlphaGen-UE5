#include "/Engine/Public/Platform.ush"
#include "/Plugin/AlphaGen/Private/AlphaGenCommon.ush"
#include "/Engine/Private/Common.ush"

// Output texture for all kernels
RWTexture2D<float4> OutputTexture;

// Shared parameters
uint2 TextureSize;
float4 ProceduralParams;  // x=Falloff/Scale, y=EdgeSoftness/Octaves, z=Seed, w=Unused
float4 ProceduralParams2; // Pattern-specific: x=Width, y=Height, z=Mortar/Spacing, w=Unused

// Generator type definitions
#define GEN_RADIAL   0
#define GEN_CIRCLE   1
#define GEN_SQUARE   2
#define GEN_DIAMOND  3
#define GEN_PERLIN   4
#define GEN_VORONOI  5
#define GEN_BRICKS   6
#define GEN_DOTS     7

// Radial falloff kernel
[numthreads(8, 8, 1)]
void GenerateRadialCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (DispatchThreadId.x >= TextureSize.x || DispatchThreadId.y >= TextureSize.y)
        return;
    
    float2 uv = (float2(DispatchThreadId.xy) + 0.5) / float2(TextureSize);
    
    float falloff_power = ProceduralParams.x;
    float value = radial_falloff(uv, falloff_power);
    
    OutputTexture[DispatchThreadId.xy] = float4(value, value, value, 1.0);
}

// Circle kernel
[numthreads(8, 8, 1)]
void GenerateCircleCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (DispatchThreadId.x >= TextureSize.x || DispatchThreadId.y >= TextureSize.y)
        return;
    
    float2 uv = (float2(DispatchThreadId.xy) + 0.5) / float2(TextureSize);
    
    float radius = ProceduralParams.x;  // scale controls size
    float softness = ProceduralParams.y;
    float value = circle(uv, radius, softness);
    
    OutputTexture[DispatchThreadId.xy] = float4(value, value, value, 1.0);
}

