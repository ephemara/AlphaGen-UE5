// ============================================================================
// Compile with: kain AlphaGenFilters.kn --target usf -o AlphaGenFilters.usf
// 
// Compute shaders for post-processing alpha mask textures.
// Uses UE5 SHADER_PARAMETER_STRUCT naming conventions for direct integration.
// ============================================================================

// ============================================================================
// BLUR FILTER - Weighted box blur approximation
// FilterParams.x = blur radius (0-16)
// ============================================================================
shader compute Blur() -> ():
    uniform FilterInputTexture: Sampler2D @0
    uniform FilterOutputTexture: Image2D @1
    uniform FilterTextureSize: UVec2 @2
    uniform FilterParams: Vec4 @3
    
    let pixel = thread_id.xy
    var skip = pixel.x >= FilterTextureSize.x
    skip = skip || pixel.y >= FilterTextureSize.y
    
    let texel_size = vec2(1.0, 1.0) / vec2(float(FilterTextureSize.x), float(FilterTextureSize.y))
    let uv = (vec2(float(pixel.x), float(pixel.y)) + 0.5) * texel_size
    let radius = int(clamp(FilterParams.x, 0.0, 16.0))
    
    var sum = vec4(0.0, 0.0, 0.0, 0.0)
    var total_weight = 0.0
    
    var y = -radius
    while y <= radius:
        var x = -radius
        while x <= radius:
            let offset = vec2(float(x), float(y)) * texel_size
            let weight = 1.0 / (1.0 + length(vec2(float(x), float(y))))
            let sample_color = sample_lod(FilterInputTexture, uv + offset, 0.0)
            sum = sum + sample_color * weight
            total_weight = total_weight + weight
            x = x + 1
        y = y + 1
    
    if !skip:
        if radius == 0:
            store(FilterOutputTexture, pixel, sample_lod(FilterInputTexture, uv, 0.0))
        else:
            store(FilterOutputTexture, pixel, sum / total_weight)

// ============================================================================
// SHARPEN FILTER - Unsharp mask
// FilterParams.x = sharpen strength (0-5)
// ============================================================================
shader compute Sharpen() -> ():
    uniform FilterInputTexture: Sampler2D @0
    uniform FilterOutputTexture: Image2D @1
    uniform FilterTextureSize: UVec2 @2
    uniform FilterParams: Vec4 @3
    
    let pixel = thread_id.xy
    var skip = pixel.x >= FilterTextureSize.x
    skip = skip || pixel.y >= FilterTextureSize.y
    
    let texel_size = vec2(1.0, 1.0) / vec2(float(FilterTextureSize.x), float(FilterTextureSize.y))
    let uv = (vec2(float(pixel.x), float(pixel.y)) + 0.5) * texel_size
    let amount = FilterParams.x
    
    let center = sample_lod(FilterInputTexture, uv, 0.0)
    var blur = sample_lod(FilterInputTexture, uv + vec2(-texel_size.x, 0.0), 0.0)
    blur = blur + sample_lod(FilterInputTexture, uv + vec2(texel_size.x, 0.0), 0.0)
    blur = blur + sample_lod(FilterInputTexture, uv + vec2(0.0, -texel_size.y), 0.0)
    blur = blur + sample_lod(FilterInputTexture, uv + vec2(0.0, texel_size.y), 0.0)
    blur = blur * 0.25
    
    let detail = center - blur
    let result = saturate(center + detail * amount)
    
    if !skip:
        store(FilterOutputTexture, pixel, result)

// ============================================================================
// INVERT FILTER
// ============================================================================
shader compute Invert() -> ():
    uniform FilterInputTexture: Sampler2D @0
    uniform FilterOutputTexture: Image2D @1
    uniform FilterTextureSize: UVec2 @2
    
    let pixel = thread_id.xy
    var skip = pixel.x >= FilterTextureSize.x
    skip = skip || pixel.y >= FilterTextureSize.y
    
    let uv = (vec2(float(pixel.x), float(pixel.y)) + 0.5) / vec2(float(FilterTextureSize.x), float(FilterTextureSize.y))
    let color = sample_lod(FilterInputTexture, uv, 0.0)
    
    if !skip:
        store(FilterOutputTexture, pixel, vec4(1.0 - color.r, 1.0 - color.g, 1.0 - color.b, color.a))

// ============================================================================
// DILATE FILTER - Morphological dilation
// FilterParams.x = radius (1-16)
// ============================================================================
shader compute Dilate() -> ():
    uniform FilterInputTexture: Sampler2D @0
    uniform FilterOutputTexture: Image2D @1
    uniform FilterTextureSize: UVec2 @2
    uniform FilterParams: Vec4 @3
    
    let pixel = thread_id.xy
    var skip = pixel.x >= FilterTextureSize.x
    skip = skip || pixel.y >= FilterTextureSize.y
    
    let texel_size = vec2(1.0, 1.0) / vec2(float(FilterTextureSize.x), float(FilterTextureSize.y))
    let uv = (vec2(float(pixel.x), float(pixel.y)) + 0.5) * texel_size
    let radius = int(clamp(FilterParams.x, 1.0, 16.0))
    
    var max_val = 0.0
    var y = -radius
    while y <= radius:
        var x = -radius
        while x <= radius:
            let sample_uv = uv + vec2(float(x), float(y)) * texel_size
            let val = sample_lod(FilterInputTexture, sample_uv, 0.0).r
            max_val = max(max_val, val)
            x = x + 1
        y = y + 1
    
    let alpha = sample_lod(FilterInputTexture, uv, 0.0).a
    
    if !skip:
        store(FilterOutputTexture, pixel, vec4(max_val, max_val, max_val, alpha))

// ============================================================================
// ERODE FILTER - Morphological erosion
// FilterParams.x = radius (1-16)
// ============================================================================
shader compute Erode() -> ():
    uniform FilterInputTexture: Sampler2D @0
    uniform FilterOutputTexture: Image2D @1
    uniform FilterTextureSize: UVec2 @2
    uniform FilterParams: Vec4 @3
    
    let pixel = thread_id.xy
    var skip = pixel.x >= FilterTextureSize.x
    skip = skip || pixel.y >= FilterTextureSize.y
    
    let texel_size = vec2(1.0, 1.0) / vec2(float(FilterTextureSize.x), float(FilterTextureSize.y))
    let uv = (vec2(float(pixel.x), float(pixel.y)) + 0.5) * texel_size
    let radius = int(clamp(FilterParams.x, 1.0, 16.0))
    
    var min_val = 1.0
    var y = -radius
    while y <= radius:
        var x = -radius
        while x <= radius:
            let sample_uv = uv + vec2(float(x), float(y)) * texel_size
            let val = sample_lod(FilterInputTexture, sample_uv, 0.0).r
            min_val = min(min_val, val)
            x = x + 1
        y = y + 1
    
    let alpha = sample_lod(FilterInputTexture, uv, 0.0).a
    
    if !skip:
        store(FilterOutputTexture, pixel, vec4(min_val, min_val, min_val, alpha))

// ============================================================================
// THRESHOLD FILTER
// FilterParams.x = threshold cutoff (0-1)
// ============================================================================
shader compute Threshold() -> ():
    uniform FilterInputTexture: Sampler2D @0
    uniform FilterOutputTexture: Image2D @1
    uniform FilterTextureSize: UVec2 @2
    uniform FilterParams: Vec4 @3
    
    let pixel = thread_id.xy
    var skip = pixel.x >= FilterTextureSize.x
    skip = skip || pixel.y >= FilterTextureSize.y
    
    let uv = (vec2(float(pixel.x), float(pixel.y)) + 0.5) / vec2(float(FilterTextureSize.x), float(FilterTextureSize.y))
    let color = sample_lod(FilterInputTexture, uv, 0.0)
    let val = step(FilterParams.x, color.r)
    
    if !skip:
        store(FilterOutputTexture, pixel, vec4(val, val, val, color.a))

// ============================================================================
// POSTERIZE FILTER
// FilterParams.x = number of steps (2-256)
// ============================================================================
shader compute Posterize() -> ():
    uniform FilterInputTexture: Sampler2D @0
    uniform FilterOutputTexture: Image2D @1
    uniform FilterTextureSize: UVec2 @2
    uniform FilterParams: Vec4 @3
    
    let pixel = thread_id.xy
    var skip = pixel.x >= FilterTextureSize.x
    skip = skip || pixel.y >= FilterTextureSize.y
    
    let uv = (vec2(float(pixel.x), float(pixel.y)) + 0.5) / vec2(float(FilterTextureSize.x), float(FilterTextureSize.y))
    let color = sample_lod(FilterInputTexture, uv, 0.0)
    let steps = max(2.0, FilterParams.x)
    let val = floor(color.r * steps) / (steps - 1.0)
    
    if !skip:
        store(FilterOutputTexture, pixel, vec4(val, val, val, color.a))

// ============================================================================
// PIXELATE FILTER
// FilterParams.x = block size in pixels
// ============================================================================
shader compute Pixelate() -> ():
    uniform FilterInputTexture: Sampler2D @0
    uniform FilterOutputTexture: Image2D @1
    uniform FilterTextureSize: UVec2 @2
    uniform FilterParams: Vec4 @3
    
    let pixel = thread_id.xy
    var skip = pixel.x >= FilterTextureSize.x
    skip = skip || pixel.y >= FilterTextureSize.y
    
    let tex_size = vec2(float(FilterTextureSize.x), float(FilterTextureSize.y))
    let uv = (vec2(float(pixel.x), float(pixel.y)) + 0.5) / tex_size
    let size = max(1.0, FilterParams.x)
    let block_uv = floor(uv * tex_size / size) * size / tex_size
    let centered = block_uv + (size * 0.5) / tex_size
    let color = sample_lod(FilterInputTexture, centered, 0.0)
    
    if !skip:
        store(FilterOutputTexture, pixel, color)

// ============================================================================
// EDGE DETECT FILTER - Sobel
// FilterParams.x = edge strength multiplier
// ============================================================================
shader compute EdgeDetect() -> ():
    uniform FilterInputTexture: Sampler2D @0
    uniform FilterOutputTexture: Image2D @1
    uniform FilterTextureSize: UVec2 @2
    uniform FilterParams: Vec4 @3
    
    let pixel = thread_id.xy
    var skip = pixel.x >= FilterTextureSize.x
    skip = skip || pixel.y >= FilterTextureSize.y
    
    let texel_size = vec2(1.0, 1.0) / vec2(float(FilterTextureSize.x), float(FilterTextureSize.y))
    let uv = (vec2(float(pixel.x), float(pixel.y)) + 0.5) * texel_size
    
    let tl = sample_lod(FilterInputTexture, uv + vec2(-texel_size.x, -texel_size.y), 0.0).r
    let t  = sample_lod(FilterInputTexture, uv + vec2(0.0, -texel_size.y), 0.0).r
    let tr = sample_lod(FilterInputTexture, uv + vec2(texel_size.x, -texel_size.y), 0.0).r
    let l  = sample_lod(FilterInputTexture, uv + vec2(-texel_size.x, 0.0), 0.0).r
    let r  = sample_lod(FilterInputTexture, uv + vec2(texel_size.x, 0.0), 0.0).r
    let bl = sample_lod(FilterInputTexture, uv + vec2(-texel_size.x, texel_size.y), 0.0).r
    let b  = sample_lod(FilterInputTexture, uv + vec2(0.0, texel_size.y), 0.0).r
    let br = sample_lod(FilterInputTexture, uv + vec2(texel_size.x, texel_size.y), 0.0).r
    
    let gx = (0.0 - tl - 2.0*l - bl) + (tr + 2.0*r + br)
    let gy = (0.0 - tl - 2.0*t - tr) + (bl + 2.0*b + br)
    let edge = saturate(sqrt(gx*gx + gy*gy) * FilterParams.x)
    
    if !skip:
        store(FilterOutputTexture, pixel, vec4(edge, edge, edge, 1.0))

// ============================================================================
// LEVELS FILTER
// FilterParams.x = black point, FilterParams.y = white point, FilterParams.z = gamma
// ============================================================================
shader compute Levels() -> ():
    uniform FilterInputTexture: Sampler2D @0
    uniform FilterOutputTexture: Image2D @1
    uniform FilterTextureSize: UVec2 @2
    uniform FilterParams: Vec4 @3
    
    let pixel = thread_id.xy
    var skip = pixel.x >= FilterTextureSize.x
    skip = skip || pixel.y >= FilterTextureSize.y
    
    let uv = (vec2(float(pixel.x), float(pixel.y)) + 0.5) / vec2(float(FilterTextureSize.x), float(FilterTextureSize.y))
    let color = sample_lod(FilterInputTexture, uv, 0.0)
    
    let bp = FilterParams.x
    let wp = max(bp + 0.01, FilterParams.y)
    let g = max(0.1, FilterParams.z)
    
    var val = (color.r - bp) / (wp - bp)
    val = saturate(val)
    val = pow(val, g)
    
    if !skip:
        store(FilterOutputTexture, pixel, vec4(val, val, val, color.a))

// ============================================================================
// CONTRAST FILTER
// FilterParams.x = contrast multiplier (0.5-2.0 typical)
// ============================================================================
shader compute Contrast() -> ():
    uniform FilterInputTexture: Sampler2D @0
    uniform FilterOutputTexture: Image2D @1
    uniform FilterTextureSize: UVec2 @2
    uniform FilterParams: Vec4 @3
    
    let pixel = thread_id.xy
    var skip = pixel.x >= FilterTextureSize.x
    skip = skip || pixel.y >= FilterTextureSize.y
    
    let uv = (vec2(float(pixel.x), float(pixel.y)) + 0.5) / vec2(float(FilterTextureSize.x), float(FilterTextureSize.y))
    let color = sample_lod(FilterInputTexture, uv, 0.0)
    let val = saturate((color.r - 0.5) * FilterParams.x + 0.5)
    
    if !skip:
        store(FilterOutputTexture, pixel, vec4(val, val, val, color.a))

// ============================================================================
// SPHERIZE FILTER
// FilterParams.x = spherize strength (-1 to 1)
// ============================================================================
shader compute Spherize() -> ():
    uniform FilterInputTexture: Sampler2D @0
    uniform FilterOutputTexture: Image2D @1
    uniform FilterTextureSize: UVec2 @2
    uniform FilterParams: Vec4 @3
    
    let pixel = thread_id.xy
    var skip = pixel.x >= FilterTextureSize.x
    skip = skip || pixel.y >= FilterTextureSize.y
    
    let uv = (vec2(float(pixel.x), float(pixel.y)) + 0.5) / vec2(float(FilterTextureSize.x), float(FilterTextureSize.y))
    let amount = FilterParams.x
    
    let centered = uv - 0.5
    let dist = length(centered)
    let dir = normalize(centered + 0.0001)
    
    var new_dist = dist * (1.0 - amount * (1.0 - dist * 2.0))
    let sphere_uv = dir * new_dist + 0.5
    
    var oob = sphere_uv.x < 0.0
    oob = oob || sphere_uv.x > 1.0
    oob = oob || sphere_uv.y < 0.0
    oob = oob || sphere_uv.y > 1.0
    
    if !skip:
        if oob:
            store(FilterOutputTexture, pixel, vec4(0.0, 0.0, 0.0, 1.0))
        else:
            store(FilterOutputTexture, pixel, sample_lod(FilterInputTexture, sphere_uv, 0.0))

// ============================================================================
// SPIRAL FILTER
// FilterParams.x = twist amount (radians at center)
// ============================================================================
shader compute Spiral() -> ():
    uniform FilterInputTexture: Sampler2D @0
    uniform FilterOutputTexture: Image2D @1
    uniform FilterTextureSize: UVec2 @2
    uniform FilterParams: Vec4 @3
    
    let pixel = thread_id.xy
    var skip = pixel.x >= FilterTextureSize.x
    skip = skip || pixel.y >= FilterTextureSize.y
    
    let uv = (vec2(float(pixel.x), float(pixel.y)) + 0.5) / vec2(float(FilterTextureSize.x), float(FilterTextureSize.y))
    let centered = uv - 0.5
    let dist = length(centered)
    var angle = atan2(centered.y, centered.x)
    
    let twist = FilterParams.x * (1.0 - dist * 2.0)
    angle = angle + twist
    
    let spiral_uv = vec2(cos(angle), sin(angle)) * dist + 0.5
    
    var oob = spiral_uv.x < 0.0
    oob = oob || spiral_uv.x > 1.0
    oob = oob || spiral_uv.y < 0.0
    oob = oob || spiral_uv.y > 1.0
    
    if !skip:
        if oob:
            store(FilterOutputTexture, pixel, vec4(0.0, 0.0, 0.0, 1.0))
        else:
            store(FilterOutputTexture, pixel, sample_lod(FilterInputTexture, spiral_uv, 0.0))

// ============================================================================
// DOMAIN WARP FILTER
// FilterParams.x = warp strength, FilterParams.y = noise scale
// ============================================================================
shader compute DomainWarp() -> ():
    uniform FilterInputTexture: Sampler2D @0
    uniform FilterOutputTexture: Image2D @1
    uniform FilterTextureSize: UVec2 @2
    uniform FilterParams: Vec4 @3
    
    let pixel = thread_id.xy
    var skip = pixel.x >= FilterTextureSize.x
    skip = skip || pixel.y >= FilterTextureSize.y
    
    let uv = (vec2(float(pixel.x), float(pixel.y)) + 0.5) / vec2(float(FilterTextureSize.x), float(FilterTextureSize.y))
    let strength = FilterParams.x
    let scale = max(1.0, FilterParams.y)
    
    let noise_coord = uv * scale
    let noise_x = sin(noise_coord.x * 12.9898 + noise_coord.y * 78.233) * 43758.5453
    let noise_y = sin(noise_coord.x * 78.233 + noise_coord.y * 12.9898 + 100.0) * 43758.5453
    let disp_x = (fract(noise_x) * 2.0 - 1.0) * strength * 0.2
    let disp_y = (fract(noise_y) * 2.0 - 1.0) * strength * 0.2
    
    let warped_uv = saturate(uv + vec2(disp_x, disp_y))
    let color = sample_lod(FilterInputTexture, warped_uv, 0.0)
    
    if !skip:
        store(FilterOutputTexture, pixel, color)
